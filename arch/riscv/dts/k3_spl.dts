			u-boot,dm-spl;

			is6615a_idcdc_2: IDCDC_REG2 {
				regulator-name = "idcdc2";
				regulator-min-microvolt = <534000>;
				regulator-max-microvolt = <1000000>;
				regulator-init-microvolt = <950000>;
				regulator-boot-on;
				u-boot,dm-spl;
				regulator-state-mem {
