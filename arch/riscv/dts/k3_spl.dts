	au4562: au4562@75 {
		compatible = "spacemit,au4562";
		reg = <0x75>;
		bus = <8>;
		u-boot,dm-spl;

		regulators {
			u-boot,dm-spl;

			au4562_adcdc_1: ADCDC_REG1 {
