		};

		panel: panel {
			  compatible = "spacemit,panel";
			  status = "disabled";
		};

		i2c0: twsi0@d4010800 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xd4010800 0x0 0x38>;
			clocks = <&ccu CLK_TWSI0>;
			resets = <&reset RESET_TWSI0>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c1: twsi1@d4011000 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xd4011000 0x0 0x38>;
			clocks = <&ccu CLK_TWSI1>;
			resets = <&reset RESET_TWSI1>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c2: twsi2@d4012000 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xd4012000 0x0 0x38>;
			clocks = <&ccu CLK_TWSI2>;
			resets = <&reset RESET_TWSI2>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c3: twsi3@f0614000 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xf0614000 0x0 0x38>;
			clocks = <&ccu CLK_SEC_TWSI3>;
			resets = <&reset RESET_SEC_TWSI3>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c4: twsi4@d4012800 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xd4012800 0x0 0x38>;
			clocks = <&ccu CLK_TWSI4>;
			resets = <&reset RESET_TWSI4>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c5: twsi5@d4013800 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xd4013800 0x0 0x38>;
			clocks = <&ccu CLK_TWSI5>;
			resets = <&reset RESET_TWSI5>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c6: twsi6@d4018800 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xd4018800 0x0 0x38>;
			clocks = <&ccu CLK_TWSI6>;
			resets = <&reset RESET_TWSI6>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c8: twsi8@d401d800 {
			compatible = "spacemit,i2c";
			reg = <0x0 0xd401d800 0x0 0x38>;
			clocks = <&ccu CLK_TWSI8>;
			resets = <&reset RESET_TWSI8>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		espi0: espi@cac8c000 {
			u-boot,dm-spl;
			compatible = "spacemit,k2-espi";
			reg = <0x0 0xcac8c000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_espi0>;
			clocks = <&ccu CLK_ESPI_SCLK_SRC>, <&ccu CLK_ESPI_SCLK>, <&ccu CLK_ESPI_MCLK>;
			clock-names = "sclk_src", "sclk", "mclk";
			resets = <&reset RESET_ESPI>;
			reset-names = "espi_reset";
			assigned-clocks = <&ccu CLK_ESPI_SCLK>;
			assigned-clock-parents = <&ccu CLK_ESPI_SCLK_SRC>;

			pr_io_base = <0x86000000>;
			pr-mem-base0 = <0x84000000>;
			pr-mem-base1 = <0xCAC8C000>;

			/* Virtual-wire GPIO mapping configuration */
			/* vw-gpio-mapping = <0 0x80>,             */
			/* 				<1 0x81>,                  */
			/* 				<2 0x82>,                  */
			/* 				<3 0x83>;                  */

			/* eSPI Master configuration */
			operating-frequency = <20>;   /* 20MHz (will negotiate with slave) */
			io-mode = "single";           /* "single", "dual", or "quad" */
			alert-mode = "io1";           /* "pin" or "io1" */
			alert-type = "open-drain";    /* "open-drain" or "push-pull" */

			/* Features */
			crc-enable;                    /* Enable CRC checking */
			response-modifier-enable;      /* Enable response modifier */
			auto-gating-enable;            /* Enable auto clock gating */

			/* Channel support (master capabilities) */
			peripheral-channel-enable;     /* Enable Peripheral channel */
			vwire-channel-enable;          /* Enable Virtual Wire channel */
			oob-channel-enable;            /* Enable OOB channel */
			flash-channel-enable;          /* Enable Flash channel */

			/* Timing configuration */
			watchdog-timeout = <0xFFFF>;   /* Watchdog timeout value */
			status = "disabled";
		};

		ufs: ufs@c0e00000 {
			compatible = "spacemit,k3-ufshci";
			reg = <0x0 0xc0e00000 0x0 0x30000>;
			clocks = <&ccu CLK_UFS_ACLK>,
				 <&ccu CLK_UFS_REFCLK>;
			clock-names = "aclk", "refclk";
			resets = <&reset RESET_UFS_ACLK>;
			reset-names = "aclk_reset";
			clock-freq = <491520000>;
			ref-clk-freq = <19200000>;
			status = "disabled";
		};

		watchdog: watchdog@d4014000 {
			compatible = "spacemit,k1x-wdt";
			reg = <0x0 0xd4014000 0x0 0x1000>,
			      <0x0 0xd4051020 0x0 0x4>;
			clocks = <&ccu CLK_TIMERS0>;
			resets = <&reset RESET_TIMERS0>;
			status = "okay";
		};
	};

	wdt_reboot {
		compatible = "wdt-reboot";
		status = "okay";
	};

	/* X100 PMU (Performance Monitoring Unit) */
	pmu {
		compatible = "riscv,pmu";

		riscv,event-to-mhpmevent =
			/* CPU_CYCLES */
			<0x00001 0x0 0x1e>,
			/* INSTRUCTIONS */
			<0x00002 0x0 0x1f>,
			/* BRANCH_INSTRUCTIONS */
			<0x00005 0x0 0x01>,
			/* BRANCH_MISSES */
			<0x00006 0x0 0x02>,
			/* STALLED_CYCLES_FRONTEND */
			<0x00008 0x0 0x03>,
			/* STALLED_CYCLES_BACKEND */
			<0x00009 0x0 0x04>,
			/* L1D_READ_ACCESS */
			<0x10000 0x0 0x06>,
			/* L1D_READ_MISS */
			<0x10001 0x0 0x05>,
			/* L1D_WRITE_ACCESS */
			<0x10002 0x0 0x0a>,
			/* L1D_WRITE_MISS */
			<0x10003 0x0 0x09>,
			/* L1D_PREFETCH_ACCESS */
			<0x10004 0x0 0x08>,
			/* L1D_PREFETCH_MISS */
			<0x10005 0x0 0x07>,
			/* L1I_READ_ACCESS  */
			<0x10008 0x0 0x0c>,
			/* L1I_READ_MISS */
			<0x10009 0x0 0x0b>,
			/* DTLB_READ_ACCESS */
			<0x10018 0x0 0x16>,
			/* DTLB_WRITE_ACCESS */
			<0x1001a 0x0 0x1a>,
			/* DTLB_WRITE_MISS */
			<0x1001b 0x0 0x19>,
			/* ITLB_READ_ACCESS */
			<0x10020 0x0 0x1c>,
			/* ITLB_READ_MISS */
			<0x10021 0x0 0x1b>;

		/*
		 * 16 valid counters: mhpmcounter3 ~ mhpmcounter18
		 *   - mhpmcounter17: Cycles
		 *   - mhpmcounter18: Instructions
		 *   - mhpmcounter3~16: Other events
		 */
		riscv,event-to-mhpmcounters =
			<0x00001 0x00001 0x00020000>,
			<0x00002 0x00002 0x00040000>,
			<0x00005 0x00006 0x0001fff8>,
			<0x00008 0x00009 0x0001fff8>,
			<0x10000 0x10005 0x0001fff8>,
			<0x10008 0x10009 0x0001fff8>,
			<0x10018 0x10018 0x0001fff8>,
			<0x1001a 0x1001b 0x0001fff8>,
			<0x10020 0x10021 0x0001fff8>;

		/*
		 * 16 valid counters: mhpmcounter3 ~ mhpmcounter18
		 *   - mhpmcounter17: Cycles
		 *   - mhpmcounter18: Instructions
		 *   - mhpmcounter3~16: Other events
		 */
		riscv,raw-event-to-mhpmcounters =
			<0x0 0x01 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x02 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x03 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x04 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x05 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x06 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x07 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x08 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x09 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x0a 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x0b 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x0c 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x10 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x11 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x12 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x13 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x14 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x15 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x16 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x17 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x18 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x19 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x1a 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x1b 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x1c 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x1e 0xffffffff 0xffffffff 0x00020000>,  /* Cycles */
			<0x0 0x1f 0xffffffff 0xffffffff 0x00040000>,  /* Instructions */
			<0x0 0x20 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x21 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x22 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x24 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x25 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x26 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x27 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x28 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x29 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x2b 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x2d 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x32 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x33 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x34 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x35 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x36 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x37 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x38 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x3a 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x3b 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x3c 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x3d 0xffffffff 0xffffffff 0x0001fff8>,
			<0x0 0x3f 0xffffffff 0xffffffff 0x0001fff8>;
	};
};
