menuconfig ESPI
	bool "Enhanced SPI (eSPI) support"
	help
	  Enable support for Enhanced Serial Peripheral Interface (eSPI).
	  eSPI is designed to replace the Low Pin Count (LPC) bus for
	  communication between processors and embedded controllers.
if ESPI
config DM_ESPI
	bool "Enable Driver Model for eSPI drivers"
	depends on DM
	help
	  Enable driver model for eSPI. The eSPI interface provides
	  methods to access eSPI buses and attached devices. The uclass
	  interface is defined in include/espi.h. This allows eSPI
	  controllers to be configured through device tree properties.

config ESPI_SPACEMIT_K3
	bool "SpacemiT K3 eSPI controller"
	depends on DM_ESPI
	help
	  Enable the SpacemiT K3 eSPI controller driver. This driver can be
	  used to access eSPI devices on platforms embedding this SpacemiT
	  IP core. Supports Peripheral, VWire, OOB, and Flash channels.

endif

menuconfig SPL_ESPI
	bool "Enhanced SPI (eSPI) support in SPL"
	depends on SPL_DM
	help
	  Enable support for Enhanced Serial Peripheral Interface (eSPI) in SPL.
	  This option provides basic eSPI initialization in SPL stage, which is
	  useful for early hardware initialization before U-Boot proper.
	  Only essential initialization functions are included in SPL to minimize
	  code size. Advanced features like VWire, OOB, and Flash operations are
	  excluded from SPL build.

if SPL_ESPI

config SPL_DM_ESPI
	bool
	default y
	help
	  Enable driver model for eSPI in SPL. This is automatically enabled
	  when SPL_ESPI is selected.

config SPL_ESPI_SPACEMIT_K3
	bool "SpacemiT K3 eSPI controller in SPL"
	depends on SPL_ESPI
	default y if ESPI_SPACEMIT_K3
	help
	  Enable the SpacemiT K3 eSPI controller driver in SPL. This provides
	  basic eSPI bus initialization in SPL stage. Only core initialization
	  functions are included to minimize SPL size. Advanced operations like
	  VWire, OOB, and Flash access are not available in SPL.

endif
