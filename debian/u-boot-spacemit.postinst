#!/bin/sh
set -e

# Post-installation hook for the SpacemiT K3 U-Boot proper package.
#
# This only flashes u-boot proper (u-boot.itb) to the detected boot
# medium. The SPL chain (bootinfo, FSBL, environment) is handled by the
# u-boot-spl-spacemit package.

case "$1" in
configure)
    # Detect the boot medium and the write offsets. The helper exits
    # this script when installation must be skipped or cannot be done.
    . /usr/share/u-boot-spacemit/spacemit-boot-device.sh

    # Under UEFI the system does not boot through U-Boot proper, so the
    # u-boot.itb image is intentionally not written to the boot media.
    if [ "$IS_UEFI" -eq 1 ]; then
        exit 0
    fi

    # Files that must be present before touching the boot media.
    files="${BIN_DIR}/u-boot.itb $UBOOT"
    for file in $files; do
        if [ ! -e "$file" ]; then
            # Exit if any required file is missing.
            echo "Missing $file"
            exit 1
        fi
    done

    # All checks passed, write u-boot proper to the boot media.
    set -x
    dd if=${BIN_DIR}/u-boot.itb of=$UBOOT seek=$UBOOT_SEEK bs=1K && sync
    set +x
    ;;
esac

exit 0
