/dts-v1/;
/ {
	description = "Signed U-boot FIT image for k3";
	#address-cells = <2>;
	fit,fdt-list = "of-list";

	images {
		uboot {
			description = "U-Boot";
			type = "standalone";
			os = "u-boot";
			arch = "riscv";
			compression = "none";
			load = <0x1 0x02000000>;
			data = /incbin/("../u-boot-nodtb.bin");
			hash {
				algo = "sha256";
			};
		};
		fdt_1 {
			description = "k3_fpga_1x1";
			type = "flat_dt";
			compression = "none";
			data = /incbin/("../dtb/k3_fpga_1x1.dtb");
			hash {
				algo = "sha256";
			};
		};
	};
	configurations {
		default = "conf_1";
		conf_1 {
			description = "k3_fpga";
			loadables = "uboot";
			fdt = "fdt_1";
			signature {
				algo = "sha256,rsa2048";
				key-name-hint = "uboot_key_prv";
				sign-images = "loadables", "fdt";
			};
		};
	};
};

